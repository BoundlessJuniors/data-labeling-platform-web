# ===========================================
# Frontend Environment Variables
# ===========================================
# Copy this file to .env and update the values

# ===========================================
# API Configuration
# ===========================================
VITE_API_URL="http://localhost:3000/api/v1"

# Optional. Used after desktop installers are published as GitHub Release assets.
# Leave empty until a real release exists; disabled download options should not be enabled
# without a verified asset URL.
# Example:
# VITE_DESKTOP_RELEASE_BASE_URL=https://github.com/BoundlessJuniors/data-labeling-platform-web/releases/download/desktop-v1.0.0
VITE_DESKTOP_RELEASE_BASE_URL=

# ===========================================
# Beta Limits Configuration
# ===========================================
VITE_BETA_MAX_FILE_SIZE_BYTES=2621440
VITE_BETA_USER_MAX_DATASETS=2
VITE_BETA_DATASET_MAX_ASSETS=20
VITE_BETA_USER_MAX_STORAGE_BYTES=83886080
VITE_BETA_USER_MAX_ACTIVE_CONTRACTS=2
VITE_BETA_PUBLIC_REGISTER_LIMIT=30
VITE_BETA_MAX_REGISTERED_USERS=50
