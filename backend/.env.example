# Database
# Docker PostgreSQL runs on port 5433 (to avoid conflict with local PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/labelgun?schema=public"

# =============================================================================
# JWT Configuration
# PRODUCTION REQUIREMENTS:
#   - Must be a cryptographically strong random string (min 32 characters).
#   - Never use the example value below in production.
#   - Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# =============================================================================
JWT_SECRET="your-super-secret-jwt-key-change-in-production"

# JWT token expiry duration (e.g. 24h, 7d, 30m)
JWT_EXPIRES_IN="24h"

# Redis
REDIS_URL="redis://localhost:6379"

# App
NODE_ENV="development"
PORT=3000

# =============================================================================
# CORS — Allowed Origins (comma-separated list of full origins)
# PRODUCTION REQUIREMENTS:
#   - Must contain the real frontend origin (e.g. https://app.example.com).
#   - Must NOT contain localhost or 127.0.0.1.
#   - Must NOT use wildcard (*).
#   - The app will refuse to start in production if this is missing or invalid.
# Development fallback: http://localhost:3000 and http://localhost:5173 are used
# automatically when ALLOWED_ORIGINS is not set.
# =============================================================================
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:5173"

# =============================================================================
# CSRF Secret (optional)
# Used to sign the csrf_token cookie with HMAC-SHA256.
# If omitted, falls back to JWT_SECRET (acceptable in production since JWT_SECRET is validated).
# If provided, must be at least 32 characters.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# =============================================================================
# CSRF_SECRET=""

# =============================================================================
# Cookie SameSite policy
# Default: lax — correct for most setups where frontend and backend share the same site.
# Options: lax | strict | none
# If set to none: cookies will be marked Secure automatically.
#   - Only use none if the frontend and backend are on different sites and you need
#     cross-site cookie sending.
#   - Requires HTTPS in production.
#   - The app will refuse to start in production with COOKIE_SAMESITE=none and no HTTPS.
# Do NOT change to none unless you have a clear cross-site deployment requirement.
# =============================================================================
COOKIE_SAMESITE="lax"

# Storage CORS - Production için frontend domain'i yazılmalı: STORAGE_ALLOWED_ORIGINS="https://your-frontend-domain.com"
STORAGE_ALLOWED_ORIGINS="http://localhost:5173"

# Docker (optional - used by docker-compose)
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"
POSTGRES_DB="labelgun"
POSTGRES_PORT=5433
REDIS_PORT=6379

# MinIO / S3-Compatible Storage (replaces Cloudflare R2 in development)
R2_ACCOUNT_ID="minio-local"
R2_ACCESS_KEY_ID="minioadmin"
R2_SECRET_ACCESS_KEY="minioadmin"
R2_BUCKET_NAME="labelgun-assets"
MINIO_ENDPOINT="http://localhost:9000"

# Payment / Marketplace
# PAYMENT_PROVIDER: "mock" for development; switch to "iyzico" in production.
PAYMENT_PROVIDER="mock"
# Platform fee taken from each transaction (0.10 = 10%).
PLATFORM_FEE_RATE="0.10"
# How many minutes the client has to complete payment before it expires.
PAYMENT_EXPIRES_MINUTES=30

# Contract SLA Defaults
# Hours after dueAt before a contract is considered fully overdue and auto-cancel triggers.
CONTRACT_GRACE_PERIOD_HOURS=24
# Hours the client has to review submitted work before it auto-approves.
CONTRACT_REVIEW_WINDOW_HOURS=72
# Hours the labeler has to submit a revision after one is requested.
CONTRACT_REVISION_WINDOW_HOURS=72
# Maximum number of revision rounds allowed per contract.
CONTRACT_MAX_REVISION_COUNT=2

# Deadline Worker
DEADLINE_SCAN_INTERVAL_MS=60000
DEADLINE_SCAN_BATCH_SIZE=100

# Storage Lifecycle
# Days after contract approval before source images are eligible for purge.
STORAGE_RETENTION_DAYS=3
# How often (ms) the reconciliation scan runs to recover missed purge jobs.
STORAGE_CLEANUP_SCAN_INTERVAL_MS=3600000
# Max datasets processed per reconciliation scan batch.
STORAGE_CLEANUP_BATCH_SIZE=50
# How long (ms) a dataset may remain in purging state before reconciliation retries it (default: 6 hours).
STORAGE_PURGING_STALE_AFTER_MS=21600000

# Beta Safety Limits
BETA_MAX_FILE_SIZE_BYTES=2621440
BETA_USER_MAX_DATASETS=2
BETA_DATASET_MAX_ASSETS=20
BETA_USER_MAX_STORAGE_BYTES=83886080
BETA_USER_MAX_ACTIVE_CONTRACTS=2
BETA_PUBLIC_REGISTER_LIMIT=30
BETA_MAX_REGISTERED_USERS=50
